Harmonic oscillator

// LC tank: L=1uH C=1nF
// Resonance frequency: 5.033 MHz

ground 0

load "inductor.osdi"
load "capacitor.osdi"

model inductor  inductor
model capacitor capacitor
model isrc      isource

subckt harmonic_osc()
  // Resonance tank
  l (vout 0) inductor   l=1u
  c (vout 0) capacitor  c=1n
ends

control
  options rawfile="binary" strictsave=1
  options tran_method="am" tran_maxord=3

  elaborate circuit("harmonic_osc")

  save default

  analysis tran1 tran start=10u stop=12u step=1p icmode="uic" ic=["vout"; 1.0]

  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
import matplotlib.pyplot as plt
from rawfile import rawread

plot = rawread('tran1.raw').get()

fig1, ax1 = plt.subplots(1, 1)
fig1.suptitle('Harmonic transient')
ax1.set_ylabel('Voltage [V]')
ax1.set_xlabel('Time [us]')
ax1.plot(plot['time']*1e3, plot['vout'], label='V(out)')
ax1.grid(True)
plt.show()
>>>FILE