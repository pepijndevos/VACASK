Simple RC circuit

// RC low pass filter
// R = 1k C = 1uF -> cutoff is 160 Hz

ground 0

load "capacitor.osdi"
load "resistor.osdi"

model capacitor capacitor
model resistor  resistor
model vsrc      vsource

subckt rc_lowpass()
  // Input signal
  vin_src (vin 0)     vsrc      type="sine" mag=1
  // Filter
  r       (vin vout)  resistor  r=1k
  c       (vout 0)    capacitor c=1u
ends

control
  options rawfile="binary" strictsave=1

  elaborate circuit("rc_lowpass")

  save default

  analysis ac1 ac from=1 to=300 mode="dec" points=100

  postprocess(PYTHON, "runme.py")
endc


embed "runme.py" <<<FILE
from rawfile import rawread
import numpy as np
import matplotlib.pyplot as plt

ac1  = rawread('ac1.raw').get()
freq = ac1['frequency']
vout = ac1['vout']

G         = 20*np.log10(np.abs(vout))
G_peak    = np.max(G)
G_cutoff  = G_peak - 3
f_idx     = (np.abs(np.asarray(G) - G_cutoff)).argmin()
f_cutoff  = freq.real[f_idx]
print(f"Simulated cutoff frequency is {f_cutoff:.3f} Hz")
print(f"Real cutoff frequency is {1/(2*np.pi*1e3*1e-6):.3f} Hz")

fig1, (ax_mag, ax_ph) = plt.subplots(2, 1)
fig1.suptitle('AC analysis')
fig1.set_dpi(100)
ax_mag.set_ylabel('Magnitude [dB]')
ax_mag.semilogx(freq.real, G, label="mag(vout)")
ax_mag.axhline(G_cutoff, color='r', linestyle='--')
ax_mag.axvline(f_cutoff, color='r', linestyle='--')
ax_ph.set_ylabel('Phase [deg]')
ax_ph.set_xlabel('f [Hz]')
ax_ph.semilogx(freq.real, np.unwrap(np.angle(vout))*180/np.pi, label="ph(vout)")
plt.show()
>>>FILE