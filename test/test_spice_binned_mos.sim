SPICE MOS model-bin selection

ground 0
include "spice_binned_mos.cir" lang=ngspice

control
  abort always
  options rawfile="binary"
  analysis op1 op
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import sys

p = rawread("op1.raw").get()
i_short = (1.2 - p["out_short"]) / 2000
i_long = (1.2 - p["out_long"]) / 2000
ok = bool((i_short > 2e-5).all() and (i_long > 1e-10).all()
          and (i_short > 100 * i_long).all())
print("two geometries select distinct current bins", i_short, i_long, ok)
if isTest():
    sys.exit(not ok)
>>>FILE
