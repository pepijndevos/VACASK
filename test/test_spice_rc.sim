SPICE passive RC and source parsing

ground 0
include "spice_rc.cir" lang=ngspice

control
  abort always
  options rawfile="binary"
  analysis tran1 tran stop=5m step=2u icmode="op"
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
import sys

p = rawread("tran1.raw").get()
t = p["time"]
expected = 5 * (1 - np.exp(-(t - 1e-3) / 2e-3)) * (t >= 1e-3)
mask = (t > 1.05e-3) & (t < 4.9e-3)
ok = relDiff(p["2"][mask], expected[mask], 1e-5).max() < 0.015
print("SPICE RC analytical response", ok)
if isTest():
    sys.exit(not ok)
>>>FILE
