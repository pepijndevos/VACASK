IHP SG13G2 Colpitts oscillator - transient and PSS

// Common-base Colpitts oscillator using npn13G2 HBT.
//
// Tank: L=10 nH, C1=C2=6.3 pF -> C_eff=3.15 pF
//   f0 = 1/(2*pi*sqrt(10n * 3.15p)) = 896 MHz,  T0 = 1.117 ns
//
// DC bias (common-base):
//   VCC = 1.2 V
//   R_b1=3k, R_b2=10k  ->  V_base = 1.2*10/13 = 0.923 V
//   V_em = V_base - V_BE_on ~= 0.22 V
//   I_em = V_em / R_em = 0.22/100 = 2.2 mA
//   gm = I_em / V_T ~= 85 mS  (excess loop gain >> 1)
//
// Transient:
//   A 1 mA current pulse at t=0.2 ns kicks the LC tank.
//   Oscillation builds up over ~10 periods and reaches steady state.
//
// PSS:
//   A second subcircuit colpitts_osc_pss has the kick delayed to 200 ns
//   so it does not fire during the 1.117 ns shooting window.
//   ic=["col";0.9] perturbs the tank to start oscillation during Tstab.
//   Tper=1.117e-9 is the initial period guess; Newton refines it.

ground 0

include "sg13g2_vacask_common.lib"
include "cornerHBT.lib" section=hbt_typ

model vsrc  vsource
model isrc  isource

subckt colpitts_osc()
    vcc_src  (vcc 0)    vsrc                 dc=1.2
    r_b1     (vcc base) sg13g2_default_mod_r r=3k
    r_b2     (base 0)   sg13g2_default_mod_r r=10k
    c_bypass (base 0)   sg13g2_default_mod_c c=100p
    l1       (vcc col)  sg13g2_default_mod_l l=10n
    c1       (col em)   sg13g2_default_mod_c c=6.3p
    c2       (em 0)     sg13g2_default_mod_c c=6.3p
    r_em     (em 0)     sg13g2_default_mod_r r=100
    q1       (col base em 0) npn13G2
    // Kick at t=0.2 ns to start oscillation in transient
    i_kick   (col 0)    isrc type="pulse" val0=0 val1=1m rise=0.05n fall=0.05n width=0.5n delay=0.2n
ends

subckt colpitts_osc_pss()
    vcc_src  (vcc 0)    vsrc                 dc=1.2
    r_b1     (vcc base) sg13g2_default_mod_r r=3k
    r_b2     (base 0)   sg13g2_default_mod_r r=10k
    c_bypass (base 0)   sg13g2_default_mod_c c=100p
    l1       (vcc col)  sg13g2_default_mod_l l=10n
    c1       (col em)   sg13g2_default_mod_c c=6.3p
    c2       (em 0)     sg13g2_default_mod_c c=6.3p
    r_em     (em 0)     sg13g2_default_mod_r r=100
    q1       (col base em 0) npn13G2
    // Kick at 1.5 ns: fires during Tstab (circuit at correct OP, kicks LC tank)
    //   but NOT during the 1.117 ns PSS shooting window.
    // Root cause of old delay=200n: ic=["col";0.9] overcharged C2, pulling V_em
    // to 0.67 V → V_BE=0.25 V → HBT cut off → gm≈0 → no loop gain → kick decayed.
    // Fix: start stabilisation from icmodeOp (no ic= in analysis) so V_em≈0.22 V,
    // gm≈85 mS, loop gain >> 1, and oscillation grows after the 1.5 ns kick.
    i_kick   (col 0)    isrc type="pulse" val0=0 val1=1m rise=0.05n fall=0.05n width=0.5n delay=1.5n
ends

control
    options temp=27
    options rawfile="binary" strictsave=1
    options reltol=1e-4 abstol=1e-12 vntol=1e-6
    // Default tran_method="trap" is rejected by integrateSensitivity().
    options tran_method="gear"

    // --- Transient: 50 ns, kick at 0.2 ns ---
    //elaborate circuit("colpitts_osc")
    //save default
    //analysis tran1 tran stop=50n step=0.05n icmode="op"

    // --- PSS: autonomous circuit (kick disabled), ic perturbs col ---
    elaborate circuit("colpitts_osc_pss")
    save default
    analysis pss1 pss Tper=1.117e-9 Tstab=300e-8 EpsMax=1e-6 MaxItr=500 writestab=1

    postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
import sys

# -------------------------------------------------------------------
# Transient results
# -------------------------------------------------------------------
plot  = rawread('pss1_stabtran.raw').get()
t     = plot['time']
vcol  = plot['col']

tests = []

status = bool(np.all(np.isfinite(vcol)) and len(t) > 10)
tests.append(status)
print(f"Tran: simulation completed ({len(t)} points): {status}")

n_half  = len(t) // 2
vcol_2h = vcol[n_half:]
amp_pp  = float(np.max(vcol_2h) - np.min(vcol_2h))
status  = amp_pp > 0.1
tests.append(status)
print(f"Tran: peak-to-peak in 2nd half = {amp_pp*1e3:.1f} mV (expect > 100 mV): {status}")

dt_uni = 0.05e-9
t_uni  = np.arange(t[n_half], t[-1], dt_uni)
v_uni  = np.interp(t_uni, t[n_half:], vcol[n_half:])
v_ac   = v_uni - np.mean(v_uni)
fmag   = np.abs(np.fft.rfft(v_ac))
freqs  = np.fft.rfftfreq(len(v_ac), d=dt_uni)
ipeak  = int(np.argmax(fmag[1:]) + 1)
f_peak = float(freqs[ipeak])
status = 700e6 <= f_peak <= 1100e6
tests.append(status)
print(f"Tran: dominant peak at {f_peak/1e6:.1f} MHz (expect 700-1100 MHz): {status}")

# -------------------------------------------------------------------
# PSS results (gracefully skipped if PSS not yet converging)
# -------------------------------------------------------------------
pss_ok = False
try:
    ppss  = rawread('pss1.raw').get()
    tp    = ppss['time']
    vp    = ppss['col']
    T0    = float(tp[-1] - tp[0])
    f0    = 1.0 / T0
    vpp   = float(vp.max() - vp.min())
    print(f"PSS:  converged T0={T0:.4e} s  f0={f0/1e6:.1f} MHz  Vpp={vpp*1e3:.0f} mV")
    pss_ok = True
except Exception as e:
    print(f"PSS:  not available ({e})")

if isTest():
    sys.exit(not all(tests))
else:
    import matplotlib.pyplot as plt

    n_panels = 3 if pss_ok else 2
    fig, axes = plt.subplots(n_panels, 1, figsize=(9, 4 * n_panels))
    fig.suptitle("IHP SG13G2 Colpitts 896 MHz")

    axes[0].plot(t * 1e9, vcol, lw=0.8)
    axes[0].set_xlabel("time [ns]")
    axes[0].set_ylabel("V(col) [V]")
    axes[0].set_title(f"Transient  (Vpp = {amp_pp*1e3:.0f} mV)")

    axes[1].semilogy(freqs[1:] / 1e9, fmag[1:], lw=0.8)
    axes[1].axvline(f_peak / 1e9, color='r', ls='--', label=f"{f_peak/1e6:.0f} MHz")
    axes[1].set_xlabel("frequency [GHz]")
    axes[1].set_ylabel("|FFT| [a.u.]")
    axes[1].set_xlim(0, 4)
    axes[1].legend()

    if pss_ok:
        axes[2].plot(tp * 1e9, vp, lw=1.2, color='C1')
        axes[2].set_xlabel("time [ns]")
        axes[2].set_ylabel("V(col) [V]")
        axes[2].set_title(f"PSS converged limit cycle  f0={f0/1e6:.1f} MHz")

    plt.tight_layout()
    plt.show()
>>>FILE