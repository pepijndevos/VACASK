SPICE diode conduction and blocking

ground 0
include "spice_diode.cir" lang=ngspice

control
  abort always
  options rawfile="binary"
  analysis tran1 tran stop=2m step=2u icmode="op"
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
import sys

p = rawread("tran1.raw").get()
vin, out = p["1"], p["2"]
forward = out[vin > 1.9]
reverse = out[vin < -1.9]
ok = bool((forward > 0.5).all() and (forward < 1.8).all()
          and (np.abs(reverse) < 1e-3).all())
print("diode conducts forward and blocks reverse", ok)
if isTest():
    sys.exit(not ok)
>>>FILE
