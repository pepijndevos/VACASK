SPICE nested include and model reference

ground 0
include "spice_nested_include.cir" lang=ngspice

control
  abort always
  options rawfile="binary"
  analysis op1 op
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import sys

p = rawread("op1.raw").get()
current = -p["vin:flow(br)"]
ok = bool((current > 1e-3).all() and (current < 5e-3).all()
          and (p["out"] > 0.4).all() and (p["out"] < 1.2).all())
print("nested diode model include conducts", ok)
if isTest():
    sys.exit(not ok)
>>>FILE
