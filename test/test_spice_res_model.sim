SPICE resistor model references and subcircuit parameters

ground 0
include "spice_res_model.cir" lang=ngspice

control
  abort always
  options rawfile="binary"
  analysis op1 op
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import sys

p = rawread("op1.raw").get()
current = -p["v1:flow(br)"]
ok = bool((relDiff(current, 1 / 300, 1e-9) < 1e-3).all())
print("100 ohm + 200 ohm resistor-model subckt current", ok)
if isTest():
    sys.exit(not ok)
>>>FILE
