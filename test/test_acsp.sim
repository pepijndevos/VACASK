S-parameter analysis

ground 0 

load "resistor.osdi"
load "capacitor.osdi"

model r resistor
model c capacitor
model vsrc vsource
model vccs vccs

r1 (1 0) r r=1k
r2 (2 0) r r=2k
c1 (1 2) c c=1u
g1 (2 0 1 0) vccs gain=1e-3

// Port 1, 50 Ohm, interface plane at 1,0
vp1 (a1 0) vsrc dc=0
rp1 (a1 1) r r=50

// Port 2, 75 Ohm, interface plane at 2,0
vp2 (a2 0) vsrc dc=0
rp2 (a2 2) r r=75

control
  abort always
  
  // options rawfile="binary" reltol=1e-14 vntol=1e-12 op_debug=0 // smsig_debug=102
  analysis sp1 acsp ports=["vp1", "rp1", "vp2", "rp2"] from=1 to=100M mode="dec" points=10

  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
import sys
import diocalc

tests = []

sp1 = rawread('sp1.raw').get()

# r1 in parallel with rin
# rin1 = 1.0 / (1/100e3 + 1/1e3)
# f = np.real(stb1["frequency"])
# wexact = rin1/(rin1+10e3+100)*1e4 / (1+1j*f/1e3) / (1+1j*f/100e3) / (1+1j*f/1e6)
# 
# wf = stb1["wf"]
# status = (relDiff(wf, wexact, 1e-9) < 1e-3).all()
# tests.append(status)
# print("Wf f", status)
# 
# wr = stb1["wr"]
# status = (relDiff(wr, 0.0, 1e-9) < 1e-3).all()
# tests.append(status)
# print("Wr f", status)
# 
# 
# wf = stb2["wf"]
# status = (relDiff(wf, 0.0, 1e-9) < 1e-3).all()
# tests.append(status)
# print("Wf r", status)
# 
# wr = stb2["wr"]
# status = (relDiff(wr, wexact, 1e-9) < 1e-3).all()
# tests.append(status)
# print("Wr r", status)

if isTest():
    sys.exit(not all(tests))
else:
    import matplotlib.pyplot as plt 

    fig1 = plt.figure()
    fig1.suptitle('S parameters')
    fig1.set_dpi(100)
    fig1.add_subplot(1, 1, 1, projection='polar')
    
    s11 = sp1["s(1,1)"]
    s12 = sp1["s(1,2)"]
    s21 = sp1["s(2,1)"]
    s22 = sp1["s(2,2)"]
    fig1.axes[0].plot(np.angle(s11), np.abs(s11), label="s11")
    fig1.axes[0].plot(np.angle(s12), np.abs(s12), label="s12")
    fig1.axes[0].plot(np.angle(s21), np.abs(s21), label="s21")
    fig1.axes[0].plot(np.angle(s22), np.abs(s22), label="s22")
    fig1.legend(loc="lower right")

    plt.show()
>>>FILE
