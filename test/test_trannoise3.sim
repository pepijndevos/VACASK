Transient shot noise modulation

ground 0 

load "res.va"
load "capacitor.osdi"

model resistor res
model isource isource
model capacitor capacitor

// Noiseless response
r0 (10 0) resistor r=1k
i0 (0 10) isource type="sine" sinedc=0.0 ampl=ampl freq=1k

// Modulated shot noise
r1 (1 0) resistor r=1k pw1=1
i1 (0 1) isource type="sine" sinedc=0.0 ampl=ampl freq=1k

control
  abort always

  // print instance("r1")

  // Modulating current amplitude
  var ampl=1.0

  // Transient noise frequency range
  var fmin=50
  var fmax=100k
  
  options sweep_debug=0 op_debug=0 tran_debug=0 tran_noisedebug=0
  options rawfile="binary" strictsave=1
  options reltol=1e-3 vntol=1e-6 abstol=1e-12
  options tran_method="trap"
  options tran_laggednoise=1 
  analysis tran1 tran stop=0.2 step=1m noisefmax=fmax noisefmin=fmin
  
  // Noise baseline is at shot noise level of DC current that is equal to mean absolute current
  alter instance("i1") sinedc=2*ampl/M_PI
  elaborate changes
  analysis noise1 noise out="1" in="i1" from=fmin to=fmax mode="dec" points=10
  
  postprocess(PYTHON, "runme.py")
endc

embed "res.va" <<<FILE
`include "constants.vams"
`include "disciplines.vams"

module res(A,B);
    // Simple resistor with constant white and shot noise
    
    // Terminals and internal nodes
    inout A, B;
    electrical A,B;
    
    branch (A,B) br;
	
	(*desc= "Resistance", type="instance", units = "Ohm"*) parameter real r = 1 from [0:inf];
    (*desc= "Noise switch", type="instance", units = ""*)  parameter integer noisy = 1;
    (*desc= "White noise factor (constant)", type="instance", units = ""*)  parameter real pw0 = 0;
    (*desc= "White noise factor (current)", type="instance", units = ""*)  parameter real pw1 = 0;
    (*desc= "Current", units ="A" *) real i;
    
    analog begin
        I(br) <+ V(br)/r;
        i = V(br) / r;
        if (noisy) begin
            I(br) <+ white_noise(pw0, "white_const");
            I(br) <+ white_noise(pw1*2*`P_Q*i, "white_shot");
        end
	end
endmodule

>>>FILE

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
from scipy.signal import welch
import sys

tests=[]

plot = rawread('tran1.raw').get()
x = plot['time']
y = plot['1'] - plot['10']
print("Samples:", x.shape[0])

noise = rawread('noise1.raw').get()
reff = noise['frequency']
refpsd = noise['onoise']
fmin = reff.min()
fmax = reff.max()

# Actual time step limit is 1/fmax/oversample/2
# Average timestep should be <= timestep limit
dx = x.max()/x.shape[0]
xs = np.arange(x[0], x[-1] + dx, dx)
ys = np.interp(xs, x, y)

rms = np.mean(ys**2)**0.5
print("rms", rms)
print("rms^2", rms**2)

# Compute nperseg so that frequency resolution is fmin/2
N = xs.shape[0]
nperseg = int(np.ceil(1/dx/(fmin/2)))
print("Interpolated points:", N)
print("Segment length:", nperseg)
print("Segments:", int(np.floor(N/(nperseg/2)-1)))

f, Pxx = welch(
    ys,
    fs=1/dx,
    window='hann',
    nperseg=nperseg,      
    noverlap=nperseg/2,      
    detrend=False,
    return_onesided=True,
    scaling='density', 
    average='mean'
)

Pxxi = np.interp(reff, f, Pxx)
diff = np.abs(10*np.log10(Pxxi/refpsd)).max()
status = diff<5
print("max err [dB] =", diff, status)
tests.append(status)

if isTest():
    sys.exit(not all(tests))
else:
    import matplotlib.pyplot as plt 

    fig1, ax1 = plt.subplots(3, 1, figsize=(6,8), dpi=100)
    fig1.axes[0].set_title('Transient modulated shot noise, fmod=1kHz, R=1k')
    fig1.axes[0].set_ylabel('V(1)-V(10) [V]')
    fig1.axes[0].set_xlabel('time [ms]')
    fig1.axes[0].plot(x*1000, y, label="V(1)")
    fig1.axes[0].set_xlim(0, 1)

    fig1.axes[1].set_title('PSD')
    fig1.axes[1].set_ylabel('PSD [V^2/Hz]')
    fig1.axes[1].set_xlabel('f [Hz]')

    fig1.axes[1].loglog(f, Pxx, label="PSD")
    # fig1.axes[1].set_ylim(refpsd.min()/10, refpsd.max()*10)
    fig1.axes[1].loglog(reff, refpsd, 'r', label="PSD (AC noise, mean abs current)")
    
    fig1.axes[1].legend(loc='lower left')

    Pxxi = np.interp(reff, f, Pxx)
    fig1.axes[2].set_title('Error')
    fig1.axes[2].set_ylabel('Error [dB]')
    fig1.axes[2].set_xlabel('f [Hz]')
    fig1.axes[2].semilogx(reff, 10*np.log10(Pxxi/refpsd), label="Error")
    
    fig1.tight_layout()

    plt.show()
>>>FILE
