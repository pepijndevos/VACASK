Explicit lang= foreign include

ground 0
model vsource vsource

// Minimal ngspice-syntax model file included with an explicit dialect.
include "lang_include_models.cir" lang=ngspice

// A `.model` card is registered under an "m_"-prefixed name (C2: ngspice keeps
// .model and .subckt in separate namespaces, VACASK does not), so a native deck
// naming a SPICE model card spells it m_<name>. Subcircuit names stay bare.
r1 (n1 0) m_resr r=1k
v1 (n1 0) vsource dc=1.0

control
  abort always
  analysis op1 op
endc
