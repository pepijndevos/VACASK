Single tone HBAC

ground 0 

load "nl.va"

model vsource vsource
model nl nl

// 1kHz large signal
v1 (1 0) vsource dc=0 type="sine" sinedc=0.0 ampl=1 freq=1k tdphase=90 spur={0.0} smag=[1]
nl1 (1 0) nl a=3 c=5

// (a x)^2 + ddt (c x)^3
// 
// Periodic large signal x(t) = a cos(w0 t)
// 
// Resistive Jacobian
//   2 a^2 x(t) = 2 a^2 cos(w0 t)
//   
// Reactive Jacobian
//   3 c^3 x(t)^2 = 3 c^3 / 2 (1 + cos(2 w0 t))
// 
// Spectrum
//     0       w0     2 w0   3 w0    4 w0   5 w0
// Jr  0       2a^2   0      0       0      0
// Jc  3c^3/2  0      3c^3/2 0       0      0
//
// Small signal excitation: b cos(w t)
//   (a (cos(w0 t) + b cos(w t)))^2 -> a^2 b cos((-w0 + w) t) + a^2 b cos((w0 + w) t)
//   ddt((c (cos(w0 t) + b cos(w t)))^3) ->  
//     b c^3 / 2 w cos(w t + pi/2) +
//     3 b c^3 / 4 w cos((-2 w0 + w) t + pi/2) + 3 b c^3 / 4 w cos((2 w0 + w) t + pi/2)
//   a=3, b=1, c=5 -> a^2 b = 9
//                    3 b c^3 / 4 * 2 pi (-2000 + 10) = -1172206.76
//                    3 b c^3 / 4 * 2 pi (2000 + 10)  = 1183987.73
// 
//   (a (cos(w0 t) + b cos((w0 + w) t)))^2 -> a^2 b cos(w t) + a^2 b cos((2 w0 + w) t)
//   a=3, b=1 -> a^2 b = 9

control
  abort always
  
  // analysis op1 op
  print unknowns
  print sparsity
  options homotopy_debug=1 hb_debug=5 nr_debug=1
  analysis hbac1 hbac freq=[1k] nharm=3 outspur={[-3], [-2], [-1], [0], [1], [2], [3]} values=[10.0] // from=1 to=10k mode="dec" points=10
  
  postprocess(PYTHON, "runme.py")
endc

embed "nl.va" <<<FILE
`include "constants.vams"
`include "disciplines.vams"

module nl(n1,n2);
    // Terminals and internal nodes
    inout n1, n2;
    electrical n1,n2;
    
    (* desc = "Resistive a", type = "instance" *) parameter real a = 1;
    (* desc = "Reactive c", type = "instance" *) parameter real c = 1;

    analog begin
        I(n1,n2) <+ pow(a*V(n1,n2), 2) + ddt(pow(c*V(n1,n2), 3));
    end
endmodule
>>>FILE

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
import sys

tests = []

plot1 = rawread('hbac1.raw').get()
for name in plot1.names:
    print(name, plot1[name])

sys.exit(0)

v1 = dc1['1']
i1 = -dc1["v1:flow(br)"]

hb1 = rawread('hb1.raw').get()
f = np.real(hb1['frequency'])
i1s = -hb1['v1:flow(br)']
i1mag = np.abs(i1s)
i1ph = np.angle(i1s)*180/np.pi

print(f)
exactmag = np.zeros(f.size)
exactph = np.zeros(f.size)
exactmag[0] = 0.5
exactmag[1] = 0.75
exactmag[3] = 0.25
exactph[1] = -90
exactph[3] = 90

exact = exactmag*(np.cos(exactph*np.pi/180)+1j*np.sin(exactph*np.pi/180))
delta = np.abs(i1s-exact).max()
print("spectrum max delta:", delta)
tests.append(delta<1e-12)

if isTest():
    sys.exit(not all(tests))
else:
    import matplotlib.pyplot as plt

    fig1, ax1 = plt.subplots(3, 1, figsize=(5,8), dpi=100, constrained_layout=True)
    fig1.suptitle('HB of pow(v,3) excited by 1kHz sine, mag=1V')
    fig1.axes[0].set_title('DC response')
    fig1.axes[0].set_ylabel('I [A]')
    fig1.axes[0].set_xlabel('V [V]')
    fig1.axes[0].plot(v1, 0.5+v1**3)
    fig1.axes[0].plot(v1, i1, marker=".", color="red", linestyle="none")

    fig1.axes[1].set_title('I(v1) spectrum')
    fig1.axes[1].set_ylabel('Magnitude [A]')
    fig1.axes[1].stem(f/1e3, i1mag, markerfmt='.')
    
    fig1.axes[2].set_ylabel('Phase [deg]')
    fig1.axes[2].set_xlabel('f [kHz]')
    fig1.axes[2].stem(f/1e3, i1ph, markerfmt='.')
    
    plt.show()
>>>FILE

