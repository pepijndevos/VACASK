Transient RC response with every relreflte setting

ground 0 

load "resistor.osdi"
load "capacitor.osdi"

model resistor resistor
model capacitor capacitor
model vsource vsource

v1 (1 0) vsource type="pulse" val0=1 val1=2 rise=1u delay=1m
r1 (1 2) resistor r=1k
c1 (2 0) capacitor c=1.5u

control
  abort always

  options rawfile="binary" strictsave=1
  options reltol=1e-3 vntol=1e-6 abstol=1e-12 tran_lteratio=3.5
  options tran_method="trap" tran_rmax=0

  options relreflte="global"
  analysis tranglobal tran stop=20m step=1u icmode="op"
  options relreflte="pointglobal"
  analysis tranpointglobal tran stop=20m step=1u icmode="op"
  options relreflte="local"
  analysis tranlocal tran stop=20m step=1u icmode="op"
  options relreflte="pointlocal"
  analysis tranpointlocal tran stop=20m step=1u icmode="op"
  options relreflte="relref"
  analysis tranrelref tran stop=20m step=1u icmode="op"
  
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from vacask.rawfile import rawread
from vacask.runtest import *
import numpy as np
import sys

tests=[]
for name in ["tranglobal", "tranpointglobal", "tranlocal", "tranpointlocal", "tranrelref"]:
    plot = rawread(name+'.raw').get()
    exact = 1+((1-np.exp(-(plot['time']-1e-3)/(1e3*1.5e-6))))*(plot['time']>1e-3)
    diff = relDiff(plot['2'], exact, 1e-6).max()
    status = diff<0.0035
    print(name, "points=", len(plot['time']), "max rel err=", diff, status)
    tests.append(status)

sys.exit(not all(tests))
>>>FILE
