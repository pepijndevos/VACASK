SPICE npn/pnp cards dispatch to the Gummel-Poon sp_bjt master

ground 0
include "spice_bjt.cir" lang=ngspice

control
  abort always
  options rawfile="binary"
  analysis op1 op
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import sys

p = rawread("op1.raw").get()
v = lambda n: float(p[n][0])

# Part 1: Ic = (Vcc - v(c))/1k. bf=100 with Ib=1uA and vaf unset (no Early
# effect), so Ic is 100uA up to the base/emitter resistance drop -- a wide
# window still excludes any model other than Gummel-Poon.
ic3 = (3.0 - v("c3")) / 1e3
ic4 = (3.0 - v("c4")) / 1e3
gain = 80e-6 < ic3 < 120e-6 and 80e-6 < ic4 < 120e-6

# Part 2: an omitted substrate node must be ground, exactly.
sub_matters = abs(v("bs1") - v("bs3")) > 0.3
sub_grounded = abs(v("bs1") - v("bs2")) < 1e-12

ok = bool(gain and sub_matters and sub_grounded)
print("npn/pnp level=1 use sp_bjt (Ic = bf*Ib); omitted substrate node is ground",
      ok, "ic3", ic3, "ic4", ic4,
      "vb(omitted)", v("bs1"), "vb(gnd)", v("bs2"), "vb(emitter)", v("bs3"))
if isTest():
    sys.exit(not ok)
>>>FILE
