Print RPN of expressions, evaluate expressions

model vsrc vsource

v1 (1 0) vsrc dc=0

control
  abort always
  print rpn(a && b && c && d)
  print ("short circuit and: ", 0&&0, 0&&1, 1&&0, 1&&1)
  print rpn(a || b || c || d)
  print ("short circuit or: ", 0||0, 0||1, 1||0, 1||1)
  print rpn(a?b:c)
  print ("ternary, true, should be 10 : ", 1?10:20) separator=" " eol="\n"
  print ("ternary, false, should be 20: ", 0?10:20)
  print ("List: ", flatten({1.0, 2, "abc", {"c", 9.0, {"e", "f"}}}))
endc
