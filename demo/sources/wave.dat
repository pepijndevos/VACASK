// Waveform points as (time, value) pairs
// Lines starting with // are ignored
// Numbers are separated by whitespace, comma, or semicolon and
// can have an SI prefix

  // Ramp up to 1V
0     0
1m    1

// Hold, short spike
3m, 1;  3.2m, 1.5;  3.4m, 1

// Hold, ramp down to -0.5V
5e-3  1
7m    -500m
